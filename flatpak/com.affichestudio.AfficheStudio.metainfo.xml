<component type="desktop-application">
  <id>com.affichestudio.AfficheStudio</id>
  <name>Affiche Studio</name>
  <summary>Générateur d'affiches assisté par IA</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>
      Affiche Studio génère des affiches en HTML/CSS à partir d'un brief et de vos
      images, puis les exporte en PNG haute résolution. Compatible avec toute API
      de génération compatible OpenAI.
    </p>
    <ul>
      <li>Projets locaux, formats Story, Carré, A4 et A3</li>
      <li>Import d'images, logos et polices</li>
      <li>Aperçu live et export PNG / HTML</li>
    </ul>
  </description>
